{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/swarga-core/omixflow/schema/flow.schema.json",
  "title": "OMIXFlow project config",
  "description": "Схема .claude/omixflow/flow.yaml. Только значения проекта; правила живут в адаптерах и protocol/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tracker", "forge", "lang", "workspace", "verify"],
  "properties": {
    "version": { "type": "integer", "enum": [1], "description": "версия схемы конфига" },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "минимальная версия плагина, с которой проект совместим" }
      }
    },
    "tracker": {
      "type": "object",
      "additionalProperties": true,
      "required": ["adapter"],
      "properties": {
        "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "project": { "type": "string" },
        "id_pattern": { "type": "string" },
        "status_map": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "properties": {
            "in_work": { "type": "string" },
            "in_review": { "type": "string" },
            "done": { "type": "string" }
          }
        },
        "create_defaults": { "type": "object", "additionalProperties": true },
        "branch": { "type": "string", "default": "board", "description": "kanban: ветка доски" },
        "push": { "type": "boolean", "default": true, "description": "kanban: пушить ветку доски после каждой записи (несколько разработчиков)" },
        "dir": { "type": "string", "description": "local: каталог задач; kanban: где открыта доска (по умолчанию .tasks/board)" }
      }
    },
    "forge": {
      "type": "object",
      "additionalProperties": true,
      "required": ["adapter"],
      "properties": {
        "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
      }
    },
    "lang": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "branch"],
      "properties": {
        "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "default": "git" },
        "base": { "type": "string", "description": "main | release/*:latest | auto" },
        "branch": { "type": "string", "pattern": "\\{id\\}", "default": "task/{id}" },
        "worktree": { "type": "string", "enum": ["off", "optional", "always"], "default": "optional" },
        "setup": { "type": "string" },
        "submodules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "readonly": { "type": "boolean", "default": false }
            }
          }
        },
        "integration": { "type": "string", "enum": ["squash", "merge"], "default": "squash" },
        "delivery": { "type": "string", "enum": ["pr", "integrate", "lead"], "default": "pr", "description": "способ сдачи одиночной задачи на Finalize; у сессии под лидом по умолчанию lead" },
        "sync": { "type": "string", "enum": ["auto", "merge", "rebase"], "default": "auto", "description": "подтягивание ушедшей базы: auto — rebase, пока в ветке только артефакты, merge после кода" },
        "protected": { "type": "array", "items": { "type": "string" } },
        "repos": {
          "type": "object",
          "description": "внешние репозитории для исследования: имя (slug, проверяет doctor) → запись",
          "additionalProperties": { "$ref": "#/definitions/repo" }
        }
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test"],
      "properties": {
        "typecheck": { "$ref": "#/definitions/gate" },
        "test": { "$ref": "#/definitions/gate" },
        "lint": { "$ref": "#/definitions/gate" },
        "build": { "$ref": "#/definitions/gate" },
        "e2e": { "$ref": "#/definitions/gate" },
        "visual": { "$ref": "#/definitions/gate" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": { "type": "string", "default": ".tasks" },
        "tracked": { "type": "boolean", "default": true }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coder_iterations": { "type": "integer", "minimum": 1, "default": 7 },
        "review_passes": { "type": "integer", "minimum": 1, "default": 3 },
        "agent_rotation_steps": { "type": "integer", "minimum": 1, "default": 10 }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "s_max_files": { "type": "integer", "minimum": 1, "default": 5 },
        "m_max_files": { "type": "integer", "minimum": 1, "default": 15 }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strong": { "type": "string", "default": "opus" },
        "light": { "type": "string", "default": "sonnet" }
      }
    },
    "multitask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parallel_per_owner": { "type": "integer", "minimum": 1, "default": 1, "description": "активных частей на исполнителя при part_runner: sequential" },
        "parallel_parts": { "type": "integer", "minimum": 1, "default": 4, "description": "одновременных researcher'ов при part_runner: scheduler" },
        "push": { "type": "boolean", "default": true }
      }
    },
    "agents": {
      "type": "object",
      "description": "маппинг роли на агента проекта: coder: my-coder",
      "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "lead": {
      "type": "object",
      "additionalProperties": false,
      "description": "маршрут вопросов сессии, запущенной с --lead; без флага не действует",
      "properties": {
        "default": { "$ref": "#/definitions/leadMode", "default": "developer", "description": "режим для точек решения, не перечисленных в policy" },
        "timeout": { "type": "string", "pattern": "^[1-9][0-9]*[smh]$", "default": "10m", "description": "сколько ждать ack или brief лида, затем вопрос задаётся в сессии; после ack ожидание без ограничения" },
        "notify": {
          "type": "array",
          "items": { "type": "string", "enum": ["visible-behaviour"] },
          "default": [],
          "description": "признаки, с которыми решение лида в режиме lead идёт как lead-notify; visible-behaviour: решение меняет видимое поведение продукта"
        },
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "description": "собственные действия лида без санкции разработчика; трекер, ветки и worktree всегда по санкции",
          "properties": {
            "backlog": { "type": "string", "enum": ["lead", "developer"], "default": "lead", "description": "заметки бэклога из гочей на ветке лида" },
            "memory": { "type": "string", "enum": ["lead", "developer"], "default": "lead", "description": "запись памяти проекта" }
          }
        },
        "stall": { "type": "string", "pattern": "^[1-9][0-9]*[smh]$", "default": "15m", "description": "простой сессии без открытого вопроса дольше этого лид сообщает разработчику как подозрение на зависание" },
        "policy": {
          "type": "object",
          "description": "режим по идентификатору точки решения из protocol/dialog.md",
          "propertyNames": { "enum": ["statement", "decomposition", "design-question", "research-blocking", "handoff", "finding", "scope-change", "deadlock", "reconcile", "gotchas", "resume", "part-take", "part-blocked", "part-integrate", "delivery", "tracker.describe", "tracker.comment", "tracker.status", "forge.pr", "workspace.branch", "workspace.exit", "workspace.integrate"] },
          "additionalProperties": { "$ref": "#/definitions/leadMode" }
        }
      }
    }
  },
  "definitions": {
    "leadMode": {
      "type": "string",
      "enum": ["developer", "lead", "lead-notify", "precedent", "direct"],
      "description": "developer: разработчик через окно лида; lead: решает лид; lead-notify: решает лид и сразу показывает разработчику с правом вето; precedent: лид, только по прецеденту разработчика, иначе разработчик; direct: разработчик в сессии задачи, лид уведомлён"
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "remote"],
      "properties": {
        "path": { "type": "string", "description": "путь относительно корня домашнего проекта" },
        "remote": { "type": "string", "description": "URL remote; doctor сверяет его с origin (ssh и https равны)" },
        "ref": { "type": "string", "default": "auto", "description": "ветка, тег, sha или auto (базовая ветка чужого проекта)" },
        "setup": { "type": "boolean", "default": false, "description": "выполнять workspace.setup чужого проекта в research-worktree" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd"],
      "properties": {
        "cmd": { "type": "string" },
        "criterion": { "type": "string", "enum": ["exit-code", "zero-diagnostics", "no-new-diagnostics", "rerun-compare-set"], "default": "exit-code" },
        "scope": { "type": "string", "enum": ["root", "package"], "default": "root" },
        "background": { "type": "boolean", "default": false },
        "when": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
